# Copy to .env and adjust. Only the dataset location below is required. Never commit the
# filled-in .env -- for a share it holds a password.
#
# Several servers on this computer each get a copy of their own instead, e.g. .env.qc and
# .env.study, and no .env. Every docker compose command then names the server's file:
#     docker compose --env-file .env.study up -d --build

# ---------------------------------------------------------------- database location
# The database, already in the BoneHub format, version 1 (the folder that contains ds-0001,
# ds-0027, ...). Fill in ONE of (a) and (b) and leave the other blank; a filled-in
# BONEHUB_DATASET_PATH wins. After switching between them, see "Where the server keeps
# things" in the README: the server's state lives in the database folder.

# (a) A folder on a disk of this computer, e.g. C:/data/BoneHub_Dataset or
#     /srv/BoneHub_Dataset. NOT a mapped network drive (Z:/...): Docker Desktop cannot
#     bind-mount one and silently mounts an empty folder instead. Use (b) for that.
BONEHUB_DATASET_PATH=

# (b) A folder on an SMB share, as a UNC path with forward slashes and no trailing slash.
#       Z:/BoneHub/BoneHub_Dataset  ->  //192.168.0.10/Data/BoneHub/BoneHub_Dataset
#     `net use` prints the UNC path behind each mapped drive letter.
BONEHUB_DATASET_SHARE=

#     Credentials for that share, required with it.
#       - a password containing a comma cannot be used: the comma ends the option
#       - a literal $ must be written as $$ (docker compose expands single $)
BONEHUB_SMB_USERNAME=
BONEHUB_SMB_PASSWORD=

#     Extra mount options, comma-separated. Add the domain if the share needs one, e.g.
#     "domain=AD,vers=3.0". Lower vers only if the file server is old (3.0 -> 2.1 -> 1.0).
BONEHUB_SMB_OPTIONS=vers=3.0

# How the dataset is mounted: blank (read-write) or "ro" (read-only). The quality check needs
# it read-write. A reliability study server (BONEHUB_QC_MODE=study below) writes nothing into
# the dataset, so set "ro" for one.
BONEHUB_DATASET_ACCESS=

# ---------------------------------------------------------------------- server
# The server's name on this computer. Its container and volumes are named after it, e.g.
# its credentials volume <name>_credentials. Blank is bonehub_qc. Each server on this
# computer needs a name of its own here, e.g. bonehub_qc_study, and a port of its own below:
# an env file left at another server's name takes over that server. Renaming a server that
# has already run starts a new server, with a new admin key and no users.
COMPOSE_PROJECT_NAME=

# Host port the server is published on.
BONEHUB_QC_PORT=8000

# What the server is for. Blank: the quality check. "study": a reliability study of the
# reviewers, which runs as a server of its own, from an env file of its own with a name and a
# port of its own above (see "Reliability study" in the README). A study server keeps its
# users, the study and the readings in its credentials volume, and nothing in the dataset.
BONEHUB_QC_MODE=

# Time zone of the server's logs (server.log, logs/ds-NNNN_qualitycheck.log), as an IANA
# name, e.g. Europe/Amsterdam. The container does not follow this computer's time zone.
# Blank is UTC. submissions.jsonl always records UTC.
BONEHUB_QC_TIMEZONE=

# Leave blank to let the server generate them on first start. They are kept inside the
# container, in the <name>_credentials volume on this Docker host -- never on the share
# -- and a generated admin key is printed once, at that first start. Lost it? Print it
# again with:
#     docker compose exec bonehub-qc-server bonehub-qc-server show-admin-key
# or start a new server (docker compose down -v && docker compose up -d), which issues a
# new admin key; users then need new keys too.
# Changing BONEHUB_QC_PRIVATE_KEY invalidates every API key already issued.
# you can generate a private key with:
#     openssl rand -hex 32
BONEHUB_QC_ADMIN_KEY=
BONEHUB_QC_PRIVATE_KEY=

# Users the server has from its start, with the keys you choose for them, as name:key pairs
# separated by commas, e.g. alice:bhqc_4f9a...,bob:bhqc_77c2... Generate a key with:
#     echo bhqc_$(openssl rand -hex 24)
# At every start the server creates each user listed here that it does not have yet, and
# sets each listed user's key back to the one given here. Roles, what the user is sent and their datasets are set in the admin panel; a new
# user starts as reviewer and editor, sent the image and the segmentation. A user deleted
# in the panel comes back at the next start, unless removed here too.
BONEHUB_QC_USERS=

# ---------------------------------------------------------------------- policy
# Leave these blank to set them in the admin panel (Policy); the server starts from the
# defaults given below. A value filled in here wins over the admin panel at every start, so
# a change made in the panel is undone by the next restart.

# Restrict the server to specific datasets: comma-separated dataset ids -- their BoneHub IDs,
# e.g. "27" for ds-0027, or "27,180". Leave blank for every dataset. Because the effective config
# is written back to <dataset>/.bonehub_qc/<server id>/config.json on each start, blanking this later
# does NOT undo it -- set it to "none" to go back to all datasets.
BONEHUB_QC_ALLOWED_DATASET_IDS=

# Which scans enter the queue: a scan is queued when one label of its segmentation is in one
# of these review states, comma-separated, and of one of the origins below.
#    not_reviewed   no server on this database has reviewed it
#    reviewed       a server here has, and the segmentation is unchanged since: a second review
# The BoneHub format records no reviews; the servers do, in their .bonehub_qc folders. A label
# becomes reviewed when the administrator approves a scan in which it was accepted.
# Default: not_reviewed.
BONEHUB_QC_ELIGIBLE_REVIEW_STATES=

# Which labels enter the queue by their origin in scan.json, comma-separated: source (came with
# the source dataset), manual (drawn by hand), model, derived, or a model by name, e.g.
# model:TotalSegmentator. Default: blank, every origin.
BONEHUB_QC_ELIGIBLE_ORIGINS=

# How long a user keeps a scan before it returns to the queue, in seconds.
# Default: 86400 (24 hours).
BONEHUB_QC_LEASE_TTL_SECONDS=

# Which free scan a user is handed: "sequential" the lowest one, "random" one at random.
# Default: sequential.
BONEHUB_QC_ASSIGNMENT_STRATEGY=

# Whether the labels an editor corrected go back to a reviewer (true), or are accepted as the
# editor vouches for them and wait for the administrator's approval (false). Default: true.
BONEHUB_QC_EDITS_NEED_REVIEW=

# Also queue scans that have an image but no segmentation at all, for editors to segment
# from scratch in 3D Slicer. Reviewers are not handed them. Default: false.
BONEHUB_QC_INCLUDE_SCANS_WITHOUT_SEGMENTATION=

# Refuse a corrected segmentation whose voxel grid does not match the scan's image.
# Default: true.
BONEHUB_QC_REQUIRE_GEOMETRY_MATCH=

# Copy the scan's segmentation into this server's backups/ folder before an approval
# replaces it. Default: true.
BONEHUB_QC_KEEP_SEGMENTATION_BACKUPS=
